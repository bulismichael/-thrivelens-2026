{
  "openapi": "3.0.3",
  "info": {
    "title": "ThriveLens R0 heartbeat API",
    "version": "0.1.0",
    "description": "Anonymous, read-only, loopback-only development heartbeat. R0 production startup is disabled."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin R0 API base"
    }
  ],
  "security": [],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "summary": "Report process liveness without probing dependencies",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdRequest"
          }
        ],
        "responses": {
          "200": {
            "description": "The API process can answer",
            "headers": {
              "Cache-Control": {
                "description": "Heartbeat responses are never cacheable",
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              },
              "X-Correlation-ID": {
                "description": "Server-accepted or server-generated bounded correlation identifier",
                "schema": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "400": {
            "$ref": "#/components/responses/RequestRejected"
          },
          "403": {
            "$ref": "#/components/responses/RequestRejected"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "summary": "Report current PostgreSQL connectivity and exact migration-head readiness",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdRequest"
          }
        ],
        "responses": {
          "200": {
            "description": "PostgreSQL is reachable and at the exact expected migration head",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "The bounded current-request database check is not ready or did not complete",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailableResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "400": {
            "$ref": "#/components/responses/RequestRejected"
          },
          "403": {
            "$ref": "#/components/responses/RequestRejected"
          }
        }
      }
    },
    "/system/status": {
      "get": {
        "operationId": "getSystemStatus",
        "summary": "Report the current mobile-facing aggregate service state",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdRequest"
          }
        ],
        "responses": {
          "200": {
            "description": "The API answered; dependency state is represented in the closed body",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "400": {
            "$ref": "#/components/responses/RequestRejected"
          },
          "403": {
            "$ref": "#/components/responses/RequestRejected"
          }
        }
      }
    },
    "/system/version": {
      "get": {
        "operationId": "getSystemVersion",
        "summary": "Report bounded API and service versions",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdRequest"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded build-independent version identifiers",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemVersionResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "400": {
            "$ref": "#/components/responses/RequestRejected"
          },
          "403": {
            "$ref": "#/components/responses/RequestRejected"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CorrelationIdRequest": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "A valid bounded value may be propagated. Invalid, control-bearing, or oversized values are ignored and replaced by the server.",
        "schema": {
          "$ref": "#/components/schemas/CorrelationId"
        }
      }
    },
    "headers": {
      "CacheControlNoStore": {
        "description": "Heartbeat responses are never cacheable",
        "schema": {
          "type": "string",
          "enum": ["no-store"]
        }
      },
      "CorrelationId": {
        "description": "Server-accepted or server-generated bounded correlation identifier",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "responses": {
      "InternalError": {
        "description": "A redacted internal error",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InternalErrorResponse"
            }
          }
        }
      },
      "RequestRejected": {
        "description": "The request crossed the frozen R0 Host, Origin, or method boundary",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControlNoStore"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RequestRejectedResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LivenessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["alive"]
          }
        }
      },
      "ReadinessReadyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "database"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready"]
          },
          "database": {
            "type": "string",
            "enum": ["ready"]
          }
        }
      },
      "ReadinessUnavailableResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReadinessNotReadyResponse"
          },
          {
            "$ref": "#/components/schemas/ReadinessUnknownResponse"
          }
        ]
      },
      "ReadinessNotReadyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "database", "error"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["not_ready"]
          },
          "database": {
            "type": "string",
            "enum": ["not_ready"]
          },
          "error": {
            "$ref": "#/components/schemas/DatabaseNotReadyError"
          }
        }
      },
      "ReadinessUnknownResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "database", "error"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["not_ready"]
          },
          "database": {
            "type": "string",
            "enum": ["unknown"]
          },
          "error": {
            "$ref": "#/components/schemas/DatabaseUnknownError"
          }
        }
      },
      "DatabaseNotReadyError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["DATABASE_NOT_READY"]
          },
          "message": {
            "type": "string",
            "enum": ["Database readiness could not be confirmed."]
          },
          "correlation_id": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        }
      },
      "DatabaseUnknownError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["DATABASE_STATUS_UNKNOWN"]
          },
          "message": {
            "type": "string",
            "enum": ["Database status is unknown."]
          },
          "correlation_id": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        }
      },
      "InternalErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/InternalError"
          }
        }
      },
      "InternalError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["INTERNAL_ERROR"]
          },
          "message": {
            "type": "string",
            "enum": ["The request could not be completed."]
          },
          "correlation_id": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        }
      },
      "RequestRejectedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/RequestRejectedError"
          }
        }
      },
      "RequestRejectedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["REQUEST_REJECTED"]
          },
          "message": {
            "type": "string",
            "enum": ["The request was rejected."]
          },
          "correlation_id": {
            "$ref": "#/components/schemas/CorrelationId"
          }
        }
      },
      "CorrelationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$",
        "minLength": 1,
        "maxLength": 64
      },
      "SystemStatusResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SystemAvailableResponse"
          },
          {
            "$ref": "#/components/schemas/SystemDatabaseNotReadyResponse"
          },
          {
            "$ref": "#/components/schemas/SystemDatabaseUnknownResponse"
          }
        ]
      },
      "SystemAvailableResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "components", "checked_at"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["available"]
          },
          "components": {
            "$ref": "#/components/schemas/ReadyComponents"
          },
          "checked_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        }
      },
      "SystemDatabaseNotReadyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "components", "checked_at"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["degraded"]
          },
          "components": {
            "$ref": "#/components/schemas/NotReadyComponents"
          },
          "checked_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        }
      },
      "SystemDatabaseUnknownResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "components", "checked_at"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["degraded"]
          },
          "components": {
            "$ref": "#/components/schemas/UnknownComponents"
          },
          "checked_at": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        }
      },
      "ReadyComponents": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_service", "database"],
        "properties": {
          "app_service": {
            "type": "string",
            "enum": ["available"]
          },
          "database": {
            "type": "string",
            "enum": ["ready"]
          }
        }
      },
      "NotReadyComponents": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_service", "database"],
        "properties": {
          "app_service": {
            "type": "string",
            "enum": ["available"]
          },
          "database": {
            "type": "string",
            "enum": ["not_ready"]
          }
        }
      },
      "UnknownComponents": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_service", "database"],
        "properties": {
          "app_service": {
            "type": "string",
            "enum": ["available"]
          },
          "database": {
            "type": "string",
            "enum": ["unknown"]
          }
        }
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
        "minLength": 20,
        "maxLength": 20
      },
      "SystemVersionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["api_version", "service_version"],
        "properties": {
          "api_version": {
            "type": "string",
            "enum": ["v1"]
          },
          "service_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "minLength": 5,
            "maxLength": 32
          }
        }
      }
    }
  }
}
