# Repository-local fallbacks remain ignored. Preferred attributable toolchains,
# caches, worktrees, and data live under the separately counted local ThriveLens root.
.tooling/
.cache/
.worktrees/
.venv/
**/.venv/
**/node_modules/
**/.expo/
**/.metro/
**/.gradle/
**/.next/
**/build/
**/dist/
**/coverage/
**/.coverage
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/__pycache__/
*.py[cod]

# Local runtime state and credentials.
.env
.env.*
!.env.example
data/
logs/
*.log
*.pid
*.pem
*.pfx
*.key

# ML artifacts
ml/models/checkpoints/*.pt
ml/models/exported/*.onnx
ml/data/raw/
ml/data/processed/
ml/data/augmented/

# IDE and operating-system state.
.idea/
.vscode/
.DS_Store
Thumbs.db
